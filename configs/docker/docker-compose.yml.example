# /opt/projet-keycloak/docker-compose.yml  (exemple — secrets à remplacer)

services:
  # ============================
  # POSTGRES KEYCLOAK
  # ============================
  postgres-keycloak:
    image: postgres:15
    container_name: postgres-keycloak
    restart: always
    environment:
      POSTGRES_DB: keycloak
      POSTGRES_USER: keycloak
      POSTGRES_PASSWORD: <MDP_DB_KEYCLOAK>
    volumes:
      - ./data/postgres-keycloak:/var/lib/postgresql/data

  # ============================
  # KEYCLOAK
  # ============================
  keycloak:
    image: quay.io/keycloak/keycloak:latest
    container_name: keycloak
    command: start --hostname-strict=false
    restart: always
    environment:
      KC_DB: postgres
      KC_DB_URL_HOST: postgres-keycloak
      KC_DB_URL_DATABASE: keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: <MDP_DB_KEYCLOAK>
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: <MDP_ADMIN_KEYCLOAK>
      KC_HTTP_ENABLED: "true"
      KC_HOSTNAME: "http://keycloak.example.local:8080"
      KC_HOSTNAME_BACKCHANNEL_DYNAMIC: "true"
      KC_SPI_COOKIE_SAME_SITE_COOKIES: "None"
    ports:
      - "8080:8080"
    depends_on:
      - postgres-keycloak

  # ============================
  # POSTGRES WIKIJS
  # ============================
  postgres-wikijs:
    image: postgres:15
    container_name: postgres-wikijs
    restart: always
    environment:
      POSTGRES_DB: wikijs
      POSTGRES_USER: wikijs
      POSTGRES_PASSWORD: <MDP_DB_WIKIJS>
    volumes:
      - ./data/postgres-wikijs:/var/lib/postgresql/data

  # ============================
  # WIKI.JS
  # ============================
  wikijs:
    image: ghcr.io/requarks/wiki:2
    container_name: wikijs
    restart: always
    ports:
      - "8082:3000"
    environment:
      DB_TYPE: postgres
      DB_HOST: postgres-wikijs
      DB_PORT: 5432
      DB_USER: wikijs
      DB_PASS: <MDP_DB_WIKIJS>
      DB_NAME: wikijs
    depends_on:
      - postgres-wikijs
    extra_hosts:
      - "keycloak.example.local:192.168.x.20"
